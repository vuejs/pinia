{
  "name": "pinia",
  "version": "3.0.4",
  "description": "Intuitive, type safe and flexible Store for Vue",
  "keywords": [
    "api",
    "composition",
    "pigna",
    "pinia",
    "piña",
    "safe",
    "setup",
    "store",
    "ts",
    "type",
    "typed",
    "typescript",
    "vue",
    "vuex"
  ],
  "homepage": "https://pinia.vuejs.org",
  "bugs": {
    "url": "https://github.com/vuejs/pinia/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Eduardo San Martin Morote",
    "email": "posva13@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuejs/pinia.git"
  },
  "funding": "https://github.com/sponsors/posva",
  "files": [
    "index.cjs",
    "LICENSE",
    "README.md",
    "dist/*.cjs",
    "dist/*.js",
    "dist/*.mjs",
    "dist/pinia.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "index.cjs",
  "module": "dist/pinia.mjs",
  "types": "dist/pinia.d.ts",
  "unpkg": "dist/pinia.iife.js",
  "jsdelivr": "dist/pinia.iife.js",
  "exports": {
    ".": {
      "types": "./dist/pinia.d.ts",
      "node": {
        "import": {
          "production": "./dist/pinia.prod.cjs",
          "development": "./dist/pinia.mjs",
          "default": "./dist/pinia.mjs"
        },
        "require": {
          "production": "./dist/pinia.prod.cjs",
          "development": "./dist/pinia.cjs",
          "default": "./index.cjs"
        }
      },
      "import": "./dist/pinia.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s --commit-path . -l pinia -r 1",
    "test:dts": "tsc -p ./test-dts/tsconfig.json",
    "test": "pnpm run build && pnpm test:dts"
  },
  "dependencies": {
    "@vue/devtools-api": "^7.7.7"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "tsdown": "^0.20.1"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0",
    "vue": "^3.5.11"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
